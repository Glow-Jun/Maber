<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Maber.App</RootNamespace>
    <AssemblyName>Maber</AssemblyName>
    <Product>Maber</Product>
    <AssemblyTitle>Maber</AssemblyTitle>
    <Version>0.4.2</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Maber.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- 注意：不能设 EnableCoreMrtTooling=false，否则不生成应用 resources.pri，WinUI 运行时启动即崩（0xC000027B） -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Maber.Core\Maber.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Web 内核产物（由 Maber.Web 构建拷入 wwwroot），运行时必须随程序输出。
         用 None 而非 Content：Content 会被 MakePri 当资源扫描，mermaid 的 hash 文件名
         会被解析成非法资源限定符（PRI249）。运行时按 BaseDirectory\wwwroot 直读，不依赖 PRI。 -->
    <None Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- 品牌标记与窗口图标 -->
    <None Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- WinUI 3 unpackaged 的已知缺口：dotnet publish 不会带上应用自身的 Maber.App.pri，
       发布版启动即报 ms-appx:///MainWindow.xaml 找不到并崩溃。构建输出里有该文件，这里补一份。 -->
  <Target Name="CopyAppPriToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(TargetDir)$(AssemblyName).pri')" />
  </Target>
</Project>
