<Window x:Class="Maber.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="Root" Background="{ThemeResource MaberWindowBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="设置" FontSize="13" FontWeight="SemiBold" Margin="16,0,0,0"
                 VerticalAlignment="Center"/>
      <Grid x:Name="AppTitleBar" Grid.Column="1" Background="Transparent"/>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="196"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Background="{ThemeResource MaberSidebarBackgroundBrush}"
              BorderBrush="{ThemeResource MaberSidebarBorderBrush}" BorderThickness="0,0,1,0">
        <StackPanel x:Name="NavPanel" Margin="12,6" Spacing="2"/>
      </Border>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                    Padding="36,14,40,44">
        <StackPanel x:Name="PageHost" MaxWidth="760" HorizontalAlignment="Stretch"/>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
