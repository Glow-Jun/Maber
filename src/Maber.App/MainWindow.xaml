<Window x:Class="Maber.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
        xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
  <Grid x:Name="Root" Background="{ThemeResource MaberWindowBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 极简标题栏：侧栏开关（仅 Total，位于拖拽区外）+ 拖拽区 + 文件名 + 模式指示 -->
    <Grid x:Name="TitleBar" Grid.Row="0" Height="36" Background="Transparent">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Button x:Name="SidebarToggle" Grid.Column="0" Content="☰" FontSize="14" Padding="8,0"
              Style="{StaticResource GhostButtonStyle}" VerticalAlignment="Center"
              Click="OnToggleSidebar" Visibility="Collapsed"/>

      <Grid x:Name="AppTitleBar" Grid.Column="1" Background="Transparent">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
          <TextBlock x:Name="TitleText" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
          <TextBlock x:Name="ModeBadge" VerticalAlignment="Center" FontSize="11" Opacity="0.6"/>
        </StackPanel>
      </Grid>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Total Mode 侧栏：大纲 / 最近 / 速查 + 设置入口 -->
      <Border x:Name="Sidebar" Grid.Column="0" Width="240" Visibility="Collapsed"
              Background="{ThemeResource MaberSidebarBackgroundBrush}"
              BorderBrush="{ThemeResource MaberSidebarBorderBrush}" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="8,8,8,4">
            <ToggleButton x:Name="TabOutline" Content="大纲" IsChecked="True"
                          Style="{StaticResource SidebarTabStyle}" Click="OnSidebarTab"/>
            <ToggleButton x:Name="TabRecent" Content="最近"
                          Style="{StaticResource SidebarTabStyle}" Click="OnSidebarTab"/>
            <ToggleButton x:Name="TabCheat" Content="速查"
                          Style="{StaticResource SidebarTabStyle}" Click="OnSidebarTab"/>
          </StackPanel>

          <Grid Grid.Row="1">
            <ListView x:Name="SidebarOutline" IsItemClickEnabled="True" ItemClick="SidebarOutline_ItemClick"/>
            <ListView x:Name="SidebarRecent" Visibility="Collapsed" IsItemClickEnabled="True"
                      ItemClick="SidebarRecent_ItemClick"/>
            <ScrollViewer x:Name="CheatScroll" Visibility="Collapsed" Padding="12,4,12,12" FontSize="12"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="CheatPanel" Spacing="7">
                <TextBlock TextWrapping="Wrap"><Run FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"># 标题</Run><Run>  H1–H6</Run></TextBlock>
                <TextBlock TextWrapping="Wrap"><Run FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">**粗体**</Run><Run>  </Run><Run FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">*斜体*</Run><Run>  </Run><Run FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">~~删除线~~</Run></TextBlock>
                <TextBlock TextWrapping="Wrap"><Run FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">==高亮==</Run><Run>  段内换行即换行</Run></TextBlock>
                <TextBlock TextWrapping="Wrap"><Run FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">- 列表</Run><Run>  </Run><Run FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">1. 序号</Run></TextBlock>
                <TextBlock TextWrapping="Wrap"><Run FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">- [ ] 任务</Run><Run>  点击方框即写回</Run></TextBlock>
                <TextBlock TextWrapping="Wrap"><Run FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">&gt; 引用</Run><Run>  </Run><Run FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">&gt; [!note] callout</Run></TextBlock>
                <TextBlock TextWrapping="Wrap"><Run FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">`行内代码`</Run><Run>  </Run><Run FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">```代码块```</Run></TextBlock>
                <TextBlock TextWrapping="Wrap"><Run FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">| 表格 |</Run><Run>  支持表头与对齐</Run></TextBlock>
                <TextBlock TextWrapping="Wrap"><Run FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">[[wikilink]]</Run><Run>  </Run><Run FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">[[笔记|别名]]</Run></TextBlock>
                <TextBlock TextWrapping="Wrap"><Run FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">![[图片.png]]</Run><Run>  嵌入图片</Run></TextBlock>
                <TextBlock TextWrapping="Wrap"><Run FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">#标签</Run><Run>  </Run><Run FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">%%注释%%</Run></TextBlock>
                <TextBlock TextWrapping="Wrap"><Run FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">$公式$</Run><Run>  </Run><Run FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">$$公式$$</Run></TextBlock>
                <TextBlock TextWrapping="Wrap"><Run FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">```mermaid</Run><Run>  流程图 / 时序图</Run></TextBlock>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <Button x:Name="SettingsButton" Grid.Row="2" Content="设置" Margin="8" Height="32"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Style="{StaticResource GhostButtonStyle}" Click="OnOpenSettings"/>
        </Grid>
      </Border>

      <!-- Source 由代码在虚拟域名映射完成后 Navigate（避免映射前导航失败） -->
      <muxc:WebView2 x:Name="Web" Grid.Column="1"/>
    </Grid>

    <!-- 大纲悬浮（Ctrl+K）。Popup 在 Primitives 命名空间（计划的 muxc:Popup 为笔误） -->
    <primitives:Popup x:Name="OutlinePopup" IsLightDismissEnabled="True">
      <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
              CornerRadius="10" Padding="8" Width="280" MaxHeight="480">
        <ScrollViewer>
          <ListView x:Name="OutlineList" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OutlineList_ItemClick"/>
        </ScrollViewer>
      </Border>
    </primitives:Popup>

    <!-- 查找悬浮（Ctrl+F，Enter 下一个 / Shift+Enter 上一个） -->
    <primitives:Popup x:Name="FindPopup" IsLightDismissEnabled="True">
      <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
              CornerRadius="10" Padding="10">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox x:Name="FindBox" MinWidth="260" KeyDown="FindBox_KeyDown"/>
          <muxc:Button Content="下一个" Click="OnFindNext"/>
        </StackPanel>
      </Border>
    </primitives:Popup>

    <!-- 外部修改提示 -->
    <muxc:InfoBar x:Name="ExternalBar" Grid.Row="1" VerticalAlignment="Top" Margin="0,8,8,0"
                  Severity="Warning" Title="文件已被外部修改" IsOpen="False" IsClosable="True">
      <muxc:InfoBar.ActionButton>
        <muxc:Button Content="加载外部内容" Click="OnReloadExternal"/>
      </muxc:InfoBar.ActionButton>
    </muxc:InfoBar>

  </Grid>
</Window>
