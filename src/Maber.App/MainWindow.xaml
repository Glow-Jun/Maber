<Window x:Class="Maber.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
        xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
  <Grid x:Name="Root" Background="{ThemeResource MaberWindowBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 极简标题栏：侧栏开关（仅 Total，位于拖拽区外）+ 拖拽区 + 文件名 + 模式指示 -->
    <Grid x:Name="TitleBar" Grid.Row="0" Height="40" Background="Transparent">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Button x:Name="SidebarToggle" Grid.Column="0" Content="☰" FontSize="15" Padding="0"
              Width="32" Height="32" Margin="6,0,0,0"
              Style="{StaticResource GhostButtonStyle}" VerticalAlignment="Center"
              Click="OnToggleSidebar" Visibility="Collapsed"/>

      <Grid x:Name="AppTitleBar" Grid.Column="1" Background="Transparent">
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="10,0,0,0">
          <TextBlock x:Name="TitleText" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
          <TextBlock x:Name="ModeBadge" VerticalAlignment="Center" FontSize="11" Opacity="0.55"/>
        </StackPanel>
      </Grid>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Total Mode 侧栏：大纲 / 最近 / 速查 + 设置入口 -->
      <Border x:Name="Sidebar" Grid.Column="0" Width="240" Visibility="Collapsed"
              Background="{ThemeResource MaberSidebarBackgroundBrush}"
              BorderBrush="{ThemeResource MaberSidebarBorderBrush}" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="8,14,8,8"
                      HorizontalAlignment="Center">
            <Grid>
              <ToggleButton x:Name="TabOutline" Content="大纲" IsChecked="True" IsTabStop="False"
                            Style="{StaticResource SidebarTabStyle}" Click="OnSidebarTab"/>
              <Border x:Name="TabOutlineLine" Height="2" Width="18" CornerRadius="1"
                      Margin="0,0,0,1" Background="{ThemeResource MaberAccentBrush}"
                      HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
            </Grid>
            <Grid>
              <ToggleButton x:Name="TabRecent" Content="最近" IsTabStop="False"
                            Style="{StaticResource SidebarTabStyle}" Click="OnSidebarTab"/>
              <Border x:Name="TabRecentLine" Height="2" Width="18" CornerRadius="1"
                      Margin="0,0,0,1" Background="{ThemeResource MaberAccentBrush}"
                      HorizontalAlignment="Center" VerticalAlignment="Bottom" Opacity="0"/>
            </Grid>
            <Grid>
              <ToggleButton x:Name="TabCheat" Content="速查" IsTabStop="False"
                            Style="{StaticResource SidebarTabStyle}" Click="OnSidebarTab"/>
              <Border x:Name="TabCheatLine" Height="2" Width="18" CornerRadius="1"
                      Margin="0,0,0,1" Background="{ThemeResource MaberAccentBrush}"
                      HorizontalAlignment="Center" VerticalAlignment="Bottom" Opacity="0"/>
            </Grid>
          </StackPanel>

          <Grid Grid.Row="1">
            <ListView x:Name="SidebarOutline" IsItemClickEnabled="True" ItemClick="SidebarOutline_ItemClick">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                  <Setter Property="Padding" Value="12,5"/>
                  <Setter Property="MinHeight" Value="32"/>
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
              </ListView.ItemContainerStyle>
            </ListView>
            <ListView x:Name="SidebarRecent" Visibility="Collapsed" IsItemClickEnabled="True"
                      ItemClick="SidebarRecent_ItemClick">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                  <Setter Property="Padding" Value="12,6"/>
                  <Setter Property="MinHeight" Value="34"/>
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
              </ListView.ItemContainerStyle>
            </ListView>
            <ScrollViewer x:Name="CheatScroll" Visibility="Collapsed" Padding="12,2,12,14"
                          VerticalScrollBarVisibility="Auto">
              <ScrollViewer.Resources>
                <Style x:Key="CheatGroupStyle" TargetType="TextBlock">
                  <Setter Property="FontSize" Value="10.5"/>
                  <Setter Property="FontWeight" Value="SemiBold"/>
                  <Setter Property="Foreground" Value="{ThemeResource MaberTertiaryTextBrush}"/>
                  <Setter Property="CharacterSpacing" Value="80"/>
                  <Setter Property="Margin" Value="2,12,0,4"/>
                </Style>
                <Style x:Key="CheatSyntaxStyle" TargetType="TextBlock">
                  <Setter Property="FontFamily" Value="Cascadia Code"/>
                  <Setter Property="FontSize" Value="11"/>
                  <Setter Property="Foreground" Value="{ThemeResource MaberPrimaryTextBrush}"/>
                  <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                  <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
                <Style x:Key="CheatDescStyle" TargetType="TextBlock">
                  <Setter Property="FontSize" Value="11.5"/>
                  <Setter Property="Foreground" Value="{ThemeResource MaberSecondaryTextBrush}"/>
                  <Setter Property="TextWrapping" Value="Wrap"/>
                  <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
                <Style x:Key="CheatRowStyle" TargetType="Grid">
                  <Setter Property="Margin" Value="0,1"/>
                  <Setter Property="MinHeight" Value="20"/>
                </Style>
              </ScrollViewer.Resources>

              <StackPanel x:Name="CheatPanel" Spacing="2">
                <TextBlock Text="文本" Style="{StaticResource CheatGroupStyle}" Margin="2,0,0,4"/>
                <Grid Style="{StaticResource CheatRowStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="# 标题" Style="{StaticResource CheatSyntaxStyle}"/>
                  <TextBlock Grid.Column="1" Text="H1–H6" Style="{StaticResource CheatDescStyle}"/>
                </Grid>
                <Grid Style="{StaticResource CheatRowStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="**粗体**" Style="{StaticResource CheatSyntaxStyle}"/>
                  <TextBlock Grid.Column="1" Text="强调" Style="{StaticResource CheatDescStyle}"/>
                </Grid>
                <Grid Style="{StaticResource CheatRowStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="*斜体*" Style="{StaticResource CheatSyntaxStyle}"/>
                  <TextBlock Grid.Column="1" Text="斜体" Style="{StaticResource CheatDescStyle}"/>
                </Grid>
                <Grid Style="{StaticResource CheatRowStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="==高亮==" Style="{StaticResource CheatSyntaxStyle}"/>
                  <TextBlock Grid.Column="1" Text="标记" Style="{StaticResource CheatDescStyle}"/>
                </Grid>
                <Grid Style="{StaticResource CheatRowStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="~~删除线~~" Style="{StaticResource CheatSyntaxStyle}"/>
                  <TextBlock Grid.Column="1" Text="删除" Style="{StaticResource CheatDescStyle}"/>
                </Grid>
                <Grid Style="{StaticResource CheatRowStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="%%注释%%" Style="{StaticResource CheatSyntaxStyle}"/>
                  <TextBlock Grid.Column="1" Text="不渲染" Style="{StaticResource CheatDescStyle}"/>
                </Grid>
                <Grid Style="{StaticResource CheatRowStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="#标签" Style="{StaticResource CheatSyntaxStyle}"/>
                  <TextBlock Grid.Column="1" Text="标签" Style="{StaticResource CheatDescStyle}"/>
                </Grid>

                <TextBlock Text="结构" Style="{StaticResource CheatGroupStyle}"/>
                <Grid Style="{StaticResource CheatRowStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="- 列表" Style="{StaticResource CheatSyntaxStyle}"/>
                  <TextBlock Grid.Column="1" Text="无序列表" Style="{StaticResource CheatDescStyle}"/>
                </Grid>
                <Grid Style="{StaticResource CheatRowStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="1. 序号" Style="{StaticResource CheatSyntaxStyle}"/>
                  <TextBlock Grid.Column="1" Text="有序列表" Style="{StaticResource CheatDescStyle}"/>
                </Grid>
                <Grid Style="{StaticResource CheatRowStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="- [ ] 任务" Style="{StaticResource CheatSyntaxStyle}"/>
                  <TextBlock Grid.Column="1" Text="点击即写回" Style="{StaticResource CheatDescStyle}"/>
                </Grid>
                <Grid Style="{StaticResource CheatRowStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="&gt; 引用" Style="{StaticResource CheatSyntaxStyle}"/>
                  <TextBlock Grid.Column="1" Text="引用块" Style="{StaticResource CheatDescStyle}"/>
                </Grid>
                <Grid Style="{StaticResource CheatRowStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="&gt; [!note]" Style="{StaticResource CheatSyntaxStyle}"/>
                  <TextBlock Grid.Column="1" Text="callout" Style="{StaticResource CheatDescStyle}"/>
                </Grid>
                <Grid Style="{StaticResource CheatRowStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="`代码`" Style="{StaticResource CheatSyntaxStyle}"/>
                  <TextBlock Grid.Column="1" Text="行内代码" Style="{StaticResource CheatDescStyle}"/>
                </Grid>
                <Grid Style="{StaticResource CheatRowStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="```" Style="{StaticResource CheatSyntaxStyle}"/>
                  <TextBlock Grid.Column="1" Text="代码块" Style="{StaticResource CheatDescStyle}"/>
                </Grid>
                <Grid Style="{StaticResource CheatRowStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="| 表格 |" Style="{StaticResource CheatSyntaxStyle}"/>
                  <TextBlock Grid.Column="1" Text="表格" Style="{StaticResource CheatDescStyle}"/>
                </Grid>

                <TextBlock Text="链接与嵌入" Style="{StaticResource CheatGroupStyle}"/>
                <Grid Style="{StaticResource CheatRowStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="[[wikilink]]" Style="{StaticResource CheatSyntaxStyle}"/>
                  <TextBlock Grid.Column="1" Text="双向链接" Style="{StaticResource CheatDescStyle}"/>
                </Grid>
                <Grid Style="{StaticResource CheatRowStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="[[笔记|别名]]" Style="{StaticResource CheatSyntaxStyle}"/>
                  <TextBlock Grid.Column="1" Text="别名" Style="{StaticResource CheatDescStyle}"/>
                </Grid>
                <Grid Style="{StaticResource CheatRowStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="![[图片.png]]" Style="{StaticResource CheatSyntaxStyle}"/>
                  <TextBlock Grid.Column="1" Text="嵌入图片" Style="{StaticResource CheatDescStyle}"/>
                </Grid>

                <TextBlock Text="公式与图表" Style="{StaticResource CheatGroupStyle}"/>
                <Grid Style="{StaticResource CheatRowStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="$公式$" Style="{StaticResource CheatSyntaxStyle}"/>
                  <TextBlock Grid.Column="1" Text="行内公式" Style="{StaticResource CheatDescStyle}"/>
                </Grid>
                <Grid Style="{StaticResource CheatRowStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="$$公式$$" Style="{StaticResource CheatSyntaxStyle}"/>
                  <TextBlock Grid.Column="1" Text="块公式" Style="{StaticResource CheatDescStyle}"/>
                </Grid>
                <Grid Style="{StaticResource CheatRowStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="```mermaid" Style="{StaticResource CheatSyntaxStyle}"/>
                  <TextBlock Grid.Column="1" Text="流程图 / 时序图" Style="{StaticResource CheatDescStyle}"/>
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- 底栏：齿轮贴左，日期贴右 -->
          <Border Grid.Row="2" BorderBrush="{ThemeResource MaberSidebarBorderBrush}"
                  BorderThickness="0,1,0,0" Padding="10,8,12,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Button x:Name="SettingsButton" Grid.Column="0" Width="34" Height="34"
                      Padding="0" HorizontalAlignment="Left"
                      Style="{StaticResource GhostButtonStyle}" Click="OnOpenSettings"
                      AutomationProperties.Name="设置" ToolTipService.ToolTip="设置">
                <FontIcon Glyph="&#xE713;" FontSize="16"/>
              </Button>

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                          HorizontalAlignment="Right" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE787;" FontSize="13"
                          Foreground="{ThemeResource MaberTertiaryTextBrush}"/>
                <TextBlock x:Name="DateText" FontSize="12"
                           Foreground="{ThemeResource MaberTertiaryTextBrush}"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- Source 由代码在虚拟域名映射完成后 Navigate（避免映射前导航失败） -->
      <muxc:WebView2 x:Name="Web" Grid.Column="1"/>
    </Grid>

    <!-- 大纲悬浮（Ctrl+K）。Popup 在 Primitives 命名空间（计划的 muxc:Popup 为笔误） -->
    <primitives:Popup x:Name="OutlinePopup" IsLightDismissEnabled="True">
      <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
              CornerRadius="10" Padding="8" Width="280" MaxHeight="480">
        <ScrollViewer>
          <ListView x:Name="OutlineList" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OutlineList_ItemClick"/>
        </ScrollViewer>
      </Border>
    </primitives:Popup>

    <!-- 查找悬浮（Ctrl+F，Enter 下一个 / Shift+Enter 上一个） -->
    <primitives:Popup x:Name="FindPopup" IsLightDismissEnabled="True">
      <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
              CornerRadius="10" Padding="10">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox x:Name="FindBox" MinWidth="260" KeyDown="FindBox_KeyDown"/>
          <muxc:Button Content="下一个" Click="OnFindNext"/>
        </StackPanel>
      </Border>
    </primitives:Popup>

    <!-- 外部修改提示 -->
    <muxc:InfoBar x:Name="ExternalBar" Grid.Row="1" VerticalAlignment="Top" Margin="0,8,8,0"
                  Severity="Warning" Title="文件已被外部修改" IsOpen="False" IsClosable="True">
      <muxc:InfoBar.ActionButton>
        <muxc:Button Content="加载外部内容" Click="OnReloadExternal"/>
      </muxc:InfoBar.ActionButton>
    </muxc:InfoBar>

  </Grid>
</Window>
