<Application x:Class="Maber.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Paper & Ink：暖纸中性 + 墨色文字 + 单一陶土强调 -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="MaberWindowBackgroundBrush" Color="#FAF9F5"/>
          <SolidColorBrush x:Key="MaberSurfaceBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="MaberSidebarBackgroundBrush" Color="#F5F3EC"/>
          <SolidColorBrush x:Key="MaberSidebarBorderBrush" Color="#E6E2D8"/>
          <SolidColorBrush x:Key="MaberPrimaryTextBrush" Color="#1F1E1C"/>
          <SolidColorBrush x:Key="MaberSecondaryTextBrush" Color="#6B675F"/>
          <SolidColorBrush x:Key="MaberTertiaryTextBrush" Color="#9A958B"/>
          <SolidColorBrush x:Key="MaberAccentBrush" Color="#C96442"/>
          <SolidColorBrush x:Key="MaberAccentWeakBrush" Color="#1AC96442"/>
          <SolidColorBrush x:Key="MaberHoverBackgroundBrush" Color="#0D1F1E1C"/>
          <SolidColorBrush x:Key="MaberPressedBackgroundBrush" Color="#141F1E1C"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="MaberWindowBackgroundBrush" Color="#141413"/>
          <SolidColorBrush x:Key="MaberSurfaceBrush" Color="#1B1A18"/>
          <SolidColorBrush x:Key="MaberSidebarBackgroundBrush" Color="#121110"/>
          <SolidColorBrush x:Key="MaberSidebarBorderBrush" Color="#2A2825"/>
          <SolidColorBrush x:Key="MaberPrimaryTextBrush" Color="#E8E6DC"/>
          <SolidColorBrush x:Key="MaberSecondaryTextBrush" Color="#A8A49B"/>
          <SolidColorBrush x:Key="MaberTertiaryTextBrush" Color="#726E66"/>
          <SolidColorBrush x:Key="MaberAccentBrush" Color="#E08A6B"/>
          <SolidColorBrush x:Key="MaberAccentWeakBrush" Color="#24E08A6B"/>
          <SolidColorBrush x:Key="MaberHoverBackgroundBrush" Color="#0FE8E6DC"/>
          <SolidColorBrush x:Key="MaberPressedBackgroundBrush" Color="#17E8E6DC"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- 侧栏标签：ghost 文本 + 选中陶土下划线 -->
      <Style x:Key="SidebarTabStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{ThemeResource MaberSecondaryTextBrush}"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="UseSystemFocusVisuals" Value="False"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Grid>
                <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                        CornerRadius="7" Padding="{TemplateBinding Padding}">
                  <ContentPresenter Content="{TemplateBinding Content}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="Underline" Height="2" Width="18" CornerRadius="1"
                        Margin="0,0,0,1" Background="{ThemeResource MaberAccentBrush}"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Opacity="0"/>
                <Border x:Name="FocusRing" BorderBrush="{ThemeResource MaberAccentBrush}"
                        BorderThickness="1.5" CornerRadius="7" Opacity="0" IsHitTestVisible="False"/>
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                      <VisualState.Setters>
                        <Setter Target="Chrome.Background" Value="{ThemeResource MaberHoverBackgroundBrush}"/>
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                      <VisualState.Setters>
                        <Setter Target="Chrome.Background" Value="{ThemeResource MaberPressedBackgroundBrush}"/>
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled"/>
                  </VisualStateGroup>
                  <VisualStateGroup x:Name="CheckStates">
                    <VisualState x:Name="Unchecked">
                      <VisualState.Setters>
                        <Setter Target="Underline.Opacity" Value="0"/>
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Checked">
                      <VisualState.Setters>
                        <Setter Target="Underline.Opacity" Value="1"/>
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Indeterminate"/>
                  </VisualStateGroup>
                  <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Unfocused"/>
                    <VisualState x:Name="Focused">
                      <VisualState.Setters>
                        <Setter Target="FocusRing.Opacity" Value="1"/>
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerFocused"/>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- 幽灵按钮：设置入口与标题栏 ☰ -->
      <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{ThemeResource MaberSecondaryTextBrush}"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Grid>
                <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                  <ContentPresenter Content="{TemplateBinding Content}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"/>
                </Border>
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                      <VisualState.Setters>
                        <Setter Target="Chrome.Background" Value="{ThemeResource MaberHoverBackgroundBrush}"/>
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                      <VisualState.Setters>
                        <Setter Target="Chrome.Background" Value="{ThemeResource MaberPressedBackgroundBrush}"/>
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled"/>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
